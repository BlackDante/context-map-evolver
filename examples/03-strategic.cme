# Strategic enrichment: subdomains, Cynefin domains and
# the key-questions heuristic. Best viewed on L1.

map "Strategic map · lending"

context KYC {
  at 170 180                 // inputs on the left
  subdomain supporting
  cynefin complicated
  question "Is the applicant who they claim to be?"
}

context Pricing {
  at 170 600
  subdomain core
  cynefin complicated
  question "What interest rate and fees apply to this risk?"
}

context Underwriting {
  at 680 380                 // the hub, centre stage
  subdomain core
  cynefin complex
  question "Should we lend to this applicant, and on what terms?"
  question "What is the probability of default?"
}

context Notifications {
  at 1180 380                // output on the right
  subdomain generic
  cynefin clear
  question "How and when do we reach the customer?"
}

KYC -> Underwriting           { type customer-supplier  upstream OHS  downstream ACL }
Pricing -> Underwriting       { type partnership }
Underwriting -> Notifications { type conformist }
